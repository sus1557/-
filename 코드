import tkinter as tk
from tkinter import messagebox
from datetime import datetime, timedelta

try:
    import winsound
except ImportError:
    winsound = None


class AlarmClock:
    def __init__(self, root):
        self.root = root
        self.root.title("간단한 알람시계")
        self.root.geometry("380x330")
        self.root.resizable(False, False)

        self.alarm_time = None
        self.alarm_active = False
        self.ringing = False
        self.last_triggered = None

        tk.Label(root, text="알람시계", font=("맑은 고딕", 20, "bold")).pack(pady=(18, 5))
        self.clock_label = tk.Label(root, text="", font=("맑은 고딕", 28))
        self.clock_label.pack(pady=5)

        tk.Label(root, text="알람 시간 (시:분)", font=("맑은 고딕", 11)).pack(pady=(12, 3))
        time_frame = tk.Frame(root)
        time_frame.pack()
        self.hour_var = tk.StringVar(value="07")
        self.minute_var = tk.StringVar(value="00")
        tk.Spinbox(time_frame, from_=0, to=23, wrap=True, width=4,
                   textvariable=self.hour_var, format="%02.0f",
                   font=("맑은 고딕", 14), justify="center").pack(side="left")
        tk.Label(time_frame, text=" : ", font=("맑은 고딕", 14)).pack(side="left")
        tk.Spinbox(time_frame, from_=0, to=59, wrap=True, width=4,
                   textvariable=self.minute_var, format="%02.0f",
                   font=("맑은 고딕", 14), justify="center").pack(side="left")

        buttons = tk.Frame(root)
        buttons.pack(pady=15)
        tk.Button(buttons, text="알람 설정", width=12, command=self.set_alarm).pack(side="left", padx=5)
        tk.Button(buttons, text="알람 해제", width=12, command=self.cancel_alarm).pack(side="left", padx=5)

        self.status_label = tk.Label(root, text="알람이 설정되지 않았습니다.", fg="gray",
                                     font=("맑은 고딕", 10))
        self.status_label.pack(pady=3)
        self.stop_button = tk.Button(root, text="알람 끄기", width=18,
                                     command=self.stop_alarm, state="disabled")
        self.stop_button.pack(pady=8)

        self.update_clock()

    def update_clock(self):
        now = datetime.now()
        self.clock_label.config(text=now.strftime("%H:%M:%S"))
        if self.alarm_active and not self.ringing:
            if now.strftime("%H:%M") == self.alarm_time and now.strftime("%Y-%m-%d") != self.last_triggered:
                self.start_alarm()
                self.last_triggered = now.strftime("%Y-%m-%d")
        if self.ringing:
            self.play_sound()
        self.root.after(500, self.update_clock)

    def set_alarm(self):
        try:
            hour = int(self.hour_var.get())
            minute = int(self.minute_var.get())
            if not (0 <= hour <= 23 and 0 <= minute <= 59):
                raise ValueError
        except ValueError:
            messagebox.showerror("입력 오류", "시각을 00~23시, 분을 00~59분으로 입력하세요.")
            return

        self.alarm_time = f"{hour:02d}:{minute:02d}"
        self.alarm_active = True
        self.last_triggered = None
        self.status_label.config(text=f"매일 {self.alarm_time} 알람이 설정되었습니다.", fg="green")

    def cancel_alarm(self):
        self.alarm_active = False
        self.alarm_time = None
        self.status_label.config(text="알람이 해제되었습니다.", fg="gray")

    def start_alarm(self):
        self.ringing = True
        self.stop_button.config(state="normal")
        self.status_label.config(text="시간이 되었습니다! 알람을 끄세요.", fg="red")
        self.root.bell()

    def play_sound(self):
        if winsound:
            winsound.MessageBeep(winsound.MB_ICONEXCLAMATION)

    def stop_alarm(self):
        self.ringing = False
        self.stop_button.config(state="disabled")
        self.status_label.config(text="알람을 종료했습니다.", fg="gray")


if __name__ == "__main__":
    root = tk.Tk()
    app = AlarmClock(root)
    root.mainloop()
